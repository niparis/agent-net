<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- agent-net daemon for macOS. Install:
     sed "s|HOME_DIR|$HOME|g" com.agent-net.daemon.plist > ~/Library/LaunchAgents/com.agent-net.daemon.plist
     launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.agent-net.daemon.plist -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.agent-net.daemon</string>
  <key>ProgramArguments</key>
  <array>
    <string>HOME_DIR/.local/bin/agent-net</string>
    <string>daemon</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>2</integer>
  <key>StandardErrorPath</key>
  <string>HOME_DIR/Library/Logs/agent-net-daemon.log</string>
  <key>StandardOutPath</key>
  <string>HOME_DIR/Library/Logs/agent-net-daemon.log</string>
</dict>
</plist>
