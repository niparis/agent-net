{
  "input": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": ["list", "read", "import"],
        "description": "list: sessions that ended a turn and whose last assistant message has not been imported. read: the exact last assistant turn of one session, masked. import: create one owner ask from that turn."
      },
      "session": {
        "type": "string",
        "description": "For read and import: the session id, or its exact name, that holds the turn."
      },
      "turn": {
        "type": "string",
        "description": "For import: the turn reference returned by list or read."
      },
      "text": {
        "type": "string",
        "maxLength": 4000,
        "description": "For import: the question for the owner, in one line."
      },
      "options": {
        "type": "array",
        "items": {"type": "string"},
        "maxItems": 4,
        "description": "For import: up to four answers the owner may give."
      },
      "recommendation": {
        "type": "string",
        "description": "For import: the chief's recommendation, in one line."
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 50,
        "description": "For list: how many sessions to inspect. Default 25."
      }
    },
    "required": ["action"],
    "additionalProperties": false
  },
  "output": {
    "type": "object",
    "properties": {
      "action": {"type": "string"},
      "state": {"type": "string"},
      "sessions": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "session": {"type": "string"},
            "name": {"type": "string"},
            "harness": {"type": "string"},
            "machine": {"type": "string"},
            "state": {"type": "string"},
            "reason": {"type": "string"},
            "last_turn": {"type": "string"},
            "last_turn_at": {"type": "string"},
            "waiting": {
              "type": "object",
              "properties": {
                "kind": {"type": "string"},
                "text": {"type": "string"},
                "since": {"type": "integer"}
              },
              "additionalProperties": false
            },
            "open_ask": {"type": "string"}
          },
          "required": ["session", "harness", "state"],
          "additionalProperties": false
        }
      },
      "turn": {
        "type": "object",
        "properties": {
          "session": {"type": "string"},
          "state": {"type": "string"},
          "reason": {"type": "string"},
          "ref": {"type": "string"},
          "at": {"type": "string"},
          "text": {"type": "string"},
          "prompt": {"type": "string"},
          "prompt_at": {"type": "string"},
          "cut": {"type": "boolean"},
          "ended": {"type": "boolean"}
        },
        "required": ["session", "state"],
        "additionalProperties": false
      },
      "ask": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "state": {"type": "string"},
          "next": {"type": "string"},
          "detail": {"type": "string"}
        },
        "required": ["id", "state"],
        "additionalProperties": false
      }
    },
    "required": ["action"],
    "additionalProperties": false
  }
}
