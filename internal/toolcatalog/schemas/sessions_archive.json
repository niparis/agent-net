{
  "input": {
    "type": "object",
    "properties": {
      "reason": {
        "type": "string",
        "description": "Reason for the action, decision or proposal."
      },
      "ids": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Explicit session IDs."
      },
      "name": {
        "type": "string",
        "description": "Case-sensitive name glob."
      },
      "folder": {
        "type": "string",
        "description": "Case-sensitive folder glob; * matches one path segment."
      },
      "project": {
        "type": "string",
        "description": "Project name; empty string selects no project."
      },
      "harness": {
        "type": "string"
      },
      "created_before": {
        "type": "string",
        "description": "YYYY-MM-DD or RFC3339, UTC."
      },
      "ended_workers": {
        "type": "boolean",
        "description": "Only workers with completed runs and no active run."
      }
    },
    "required": [],
    "additionalProperties": false
  },
  "output": {
    "type": "object",
    "properties": {
      "proposal_id": {
        "type": "string"
      },
      "state": {
        "type": "string"
      },
      "result": {
        "$ref": "#/$defs/ActionResult"
      }
    },
    "required": [
      "state"
    ],
    "additionalProperties": false,
    "$defs": {
      "JSONValue": {
        "anyOf": [
          {
            "type": "null"
          },
          {
            "type": "boolean"
          },
          {
            "type": "number"
          },
          {
            "type": "string"
          },
          {
            "type": "array",
            "items": {
              "$ref": "#/$defs/JSONValue"
            }
          },
          {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/JSONValue"
            }
          }
        ]
      },
      "ActionResult": {
        "type": "object",
        "properties": {
          "summary": {
            "type": "string"
          },
          "data": {
            "$ref": "#/$defs/JSONValue"
          }
        },
        "required": [
          "summary",
          "data"
        ],
        "additionalProperties": false
      }
    }
  }
}
