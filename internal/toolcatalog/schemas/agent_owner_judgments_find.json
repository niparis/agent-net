{
  "input": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string",
        "description": "Text or keywords to search across owner judgments."
      },
      "area": {
        "type": "string",
        "description": "Optional project, repo or team name to filter by."
      },
      "kind": {
        "type": "string",
        "enum": [
          "order",
          "rule",
          "answer",
          "correction"
        ],
        "description": "Optional judgment kind: order, rule, answer, correction."
      },
      "marks": {
        "type": "boolean",
        "description": "Only the owner's Desk marks (didn't need me, should have asked me), each with its ask, the whole question and the chief's disposition."
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100,
        "default": 20,
        "description": "Maximum rows in this page, up to 100."
      },
      "offset": {
        "type": "integer",
        "minimum": 0,
        "default": 0,
        "description": "Rows to skip, for the next page."
      }
    },
    "required": [],
    "additionalProperties": false
  },
  "output": {
    "type": "object",
    "properties": {
      "items": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/Judgment"
        }
      },
      "total": {
        "type": "integer"
      },
      "marks_stored": {
        "type": "integer",
        "description": "With marks: true, how many owner marks storage holds."
      },
      "note": {
        "type": "string",
        "description": "With marks: true and no rows, says whether storage holds any marks."
      }
    },
    "required": [
      "items",
      "total"
    ],
    "additionalProperties": false,
    "$defs": {
      "Judgment": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "area": {
            "type": "string"
          },
          "ref": {
            "type": "string"
          },
          "snippet": {
            "type": "string"
          },
          "pinned": {
            "type": "boolean"
          },
          "saved_at": {
            "type": "integer"
          },
          "updated_at": {
            "type": "integer"
          },
          "source": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ask": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "disposition": {
            "type": "string"
          },
          "mark": {
            "type": "string"
          },
          "mark_text": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "text",
          "saved_at",
          "source"
        ],
        "additionalProperties": false
      }
    }
  },
  "cto_input": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string",
        "description": "Text or keywords to search across owner judgments."
      },
      "area": {
        "type": "string",
        "description": "Optional project, repo or team name to filter by."
      },
      "kind": {
        "type": "string",
        "enum": [
          "order",
          "rule",
          "answer",
          "correction"
        ],
        "description": "Optional judgment kind: order, rule, answer, correction."
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100,
        "default": 20,
        "description": "Maximum rows in this page, up to 100."
      }
    },
    "required": [],
    "additionalProperties": false
  }
}
